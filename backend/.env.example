# Copy to .env for local development. .env is gitignored — never commit real values.
# Every value here is a local placeholder. Production configuration comes from the
# secret manager, not from a file in the repository.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=3000

# Two targets, one variable:
#   * the local Docker database (infra/docker-compose.yml), for working offline
#   * the Supabase project database (docs/decisions.md D-16), session pooler on port 5432
# Integration tests never read this value — they use their own throwaway database
# (backend/test/integration/database-url.ts), so destructive helpers cannot reach real
# data.
#
# Supabase shape (replace ref, region and password):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
# sslmode=no-verify because the pooler's certificate chain is not in Node's root store;
# P11-01 pins Supabase's CA (NODE_EXTRA_CA_CERTS) and moves to sslmode=verify-full.
DATABASE_URL=postgres://mandir:mandir_local_dev@127.0.0.1:5442/mandir
DATABASE_POOL_MAX=10

# Development-only filesystem storage. The process refuses to start with
# STORAGE_DRIVER=local when NODE_ENV=production. Production uses private
# S3-compatible storage once that vendor is chosen — see docs/decisions.md D-07.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_URL_SECRET=development_only_storage_secret_change_me
STORAGE_URL_TTL_SECONDS=300
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3000

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=5
WORKER_LEASE_MS=60000
JOB_MAX_ATTEMPTS=5

# Supabase project (docs/decisions.md D-15). Access tokens are verified against this
# project's JWKS endpoint, so the process refuses to start without it. Replace with your
# own project URL (Mumbai region, per D-16) before sessions can be verified locally.
SUPABASE_URL=https://your-project.supabase.co
# Audience and issuer defaults suit a standard Supabase project; override only if the
# project's JWT settings are customised.
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
