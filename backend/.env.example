# Copy to .env for local development. .env is gitignored — never commit real values.
# Every value here is a local placeholder. Production configuration comes from the
# secret manager, not from a file in the repository.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=3000

# Matches infra/docker-compose.yml
DATABASE_URL=postgres://mandir:mandir_local_dev@127.0.0.1:5442/mandir
DATABASE_POOL_MAX=10

# Development-only filesystem storage. The process refuses to start with
# STORAGE_DRIVER=local when NODE_ENV=production. Production uses private
# S3-compatible storage once that vendor is chosen — see docs/decisions.md D-07.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_URL_SECRET=development_only_storage_secret_change_me
STORAGE_URL_TTL_SECONDS=300
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3000

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=5
WORKER_LEASE_MS=60000
JOB_MAX_ATTEMPTS=5
