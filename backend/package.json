{
  "name": "scan-my-mandir-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan My Mandir backend: Fastify API and analysis worker sharing one codebase.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start:api": "tsx src/api/index.ts",
    "start:worker": "tsx src/worker/index.ts",
    "migrate": "tsx src/shared/db/migrate-cli.ts",
    "enqueue:demo": "tsx src/shared/jobs/enqueue-cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
