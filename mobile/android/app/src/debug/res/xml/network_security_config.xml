<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Android 9 and later block cleartext HTTP by default, which is correct. The local
  backend runs on plain HTTP during development, and 10.0.2.2 is how the Android
  emulator reaches the host machine's loopback interface.

  Cleartext is allowed for those two hosts and nothing else. This file lives under
  src/debug, so it is never merged into a release build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
