{
  "name": "vision-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Throwaway spike harness: measures vision-model recognition quality, latency and cost on real mandir photos. Not part of the shipped product.",
  "license": "UNLICENSED",
  "scripts": {
    "eval": "tsx src/run.ts",
    "eval:dry": "tsx src/run.ts --dry-run",
