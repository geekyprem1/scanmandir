    "score": "node score.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  }
}
