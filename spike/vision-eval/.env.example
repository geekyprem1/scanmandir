# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required for a real run. Not needed for: npm run eval:dry
OPENROUTER_API_KEY=your_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-6-luna

# json_object measures how often the model returns malformed output.
# json_schema constrains it instead. Run both to compare.
RESPONSE_FORMAT=json_object

# Excludes providers that may retain or train on submitted data.
# See docs/decisions.md D-08. Verify against current OpenRouter docs before
# sending any photo you do not own.
DENY_DATA_COLLECTION=true

MAX_ATTEMPTS=3
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=4000

# Matches the normalized derivative in ARCHITECTURE.md section 6.
# Turning this off sends full-resolution photos and inflates token cost well
# above what production would pay.
RESIZE=true
RESIZE_MAX_EDGE=1024

# Rates as recorded in docs/decisions.md D-05 on 26 September 2026.
# GPT-6 Luna pricing changed on 23 September — re-check before trusting output.
USD_PER_MILLION_INPUT=0.1
USD_PER_MILLION_OUTPUT=0.5
USD_PER_MILLION_CACHED_INPUT=0.01
CREDIT_FEE_PERCENT=5.5
INR_PER_USD=95.9
